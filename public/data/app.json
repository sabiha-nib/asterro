 "profiles": {
  "general": {
   "label": "General analogue",
   "rationale": "Equal weight on every available criterion.",
   "weights": {
    "aridity": 1,
    "annual_temperature_range": 1,
    "elevation": 1,
    "slope": 1,
    "surface_roughness": 1,
    "lst_diurnal_range": 1
   }
  },
  "rover": {
   "label": "Rover mobility",
   "rationale": "Traversability is governed mainly by slope and roughness at the ~1 km baseline; climate is secondary.",
   "weights": {
    "aridity": 1,
    "annual_temperature_range": 0.5,
    "elevation": 1,
    "slope": 3,
    "surface_roughness": 3,
    "lst_diurnal_range": 0.5
   }
  },
  "eva": {
   "label": "EVA training",
   "rationale": "Crew exposure: dryness, thermal swings and walkable terrain.",
   "weights": {
    "aridity": 2,
    "annual_temperature_range": 1.5,
    "elevation": 1,
    "slope": 1.5,
    "surface_roughness": 1,
    "lst_diurnal_range": 2
   }
  },
  "thermal": {
   "label": "Thermal testing",
   "rationale": "Hardware thermal cycling: diurnal surface swing and seasonal air-temperature range dominate.",
   "weights": {
    "aridity": 1,
    "annual_temperature_range": 2,
    "elevation": 1,
    "slope": 0.5,
    "surface_roughness": 0.5,
    "lst_diurnal_range": 3
   }
  },
  "habitat": {
   "label": "Habitat operations",
   "rationale": "Long-duration stays: thermal environment plus low slope for construction.",
   "weights": {
    "aridity": 1.5,
    "annual_temperature_range": 2,
    "elevation": 1,
    "slope": 2,
    "surface_roughness": 1,
    "lst_diurnal_range": 2
   }
  },
  "instrument": {
   "label": "Science instrument testing",
   "rationale": "Dry surfaces and thin (high) atmosphere columns matter most for instrument analogues.",
   "weights": {
    "aridity": 3,
    "annual_temperature_range": 1,
    "elevation": 1.5,
    "slope": 1,
    "surface_roughness": 1,
    "lst_diurnal_range": 1.5
   }
  }
